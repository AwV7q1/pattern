# Copy to apps/server/.env (read by the server and by the Prisma CLI).
DATABASE_URL=postgresql://pattern:pattern@localhost:5432/pattern
# Separate database for `pnpm --filter server test` (wiped by the tests).
DATABASE_URL_TEST=postgresql://pattern:pattern@localhost:5432/pattern_test
PORT=3000
NODE_ENV=development
# Anyone may create an account (off by default: create users with the CLI).
ALLOW_SIGNUP=false
SESSION_TTL_DAYS=30
# Secure cookies need HTTPS; defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true
# Origin of the web app when it is served from another host (CORS with cookies).
# WEB_ORIGIN=https://pattern.example.com
# Behind a reverse proxy (Caddy, nginx): trust X-Forwarded-For for the session IP.
# TRUST_PROXY=1
