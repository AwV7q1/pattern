{
  "name": "server",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @pattern/design-lint build && prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "test": "pnpm --filter @pattern/design-lint build && prisma generate && tsc -p tsconfig.json && node --test dist/**/*.spec.js"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/platform-express": "^11",
    "@nestjs/throttler": "^6",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8",
    "pattern-engine-wasm": "link:../../crates/engine-wasm/pkg-node",
    "piscina": "^4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3",
    "@pattern/design-lint": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "prisma": "^6",
    "typescript": "~5.9.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
