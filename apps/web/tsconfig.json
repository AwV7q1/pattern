{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@webgpu/types",
      "vite/client",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@pattern/design-lint": [
        "../../packages/design-lint/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../packages/design-lint/src"
  ],
  "exclude": [
    "../../packages/design-lint/src/**/*.test.ts"
  ]
}
