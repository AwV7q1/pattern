        "position": {
          "x": 0,
          "y": 160
        }
      },
      {
        "id": "api",
        "kind": "service",
        "label": "Upload API",
        "position": {
          "x": 260,
          "y": 160
        },
        "config": {
          "instances": 2,
          "concurrency": 200,
          "queueSize": 100,
          "latencyP50Ms": 5,
          "latencyP99Ms": 20,
          "costPerHour": 0.1
        }
      },
      {
        "id": "q",
        "kind": "queue",
        "label": "RabbitMQ",
        "position": {
          "x": 520,
          "y": 160
        },
        "config": {
          "instances": 1,
          "concurrency": 40,
          "queueSize": 500000,
          "latencyP50Ms": 0.2,
          "latencyP99Ms": 1,
          "costPerHour": 0.08
        }
      },
      {
        "id": "worker",
        "kind": "service",
        "label": "Image worker",
        "position": {
          "x": 780,
          "y": 160
        },
