{
  "title": "Retry storm",
  "description": "DB chậm 2× từ giây 20 đến 35. API timeout 60ms + retry 3 lần: mỗi request bị timeout sinh thêm tải, DB quá tải hẳn và không tự hồi phục kể cả khi đã hết chậm (metastable failure).",
  "design": {
    "nodes": [
      {
        "id": "client",
        "kind": "client",
        "label": "Users",
        "position": {
          "x": 0,
          "y": 160
        }
      },
      {
        "id": "lb",
        "kind": "loadBalancer",
        "label": "Load Balancer",
        "position": {
          "x": 299,
          "y": 160
        },
        "config": {
          "instances": 1,
          "concurrency": 20000,
          "queueSize": 0,
          "latencyP50Ms": 0.2,
          "latencyP99Ms": 1,
          "costPerHour": 0.03
        }
      },
      {
        "id": "api",
        "kind": "service",
        "label": "API",
        "position": {
          "x": 611,
          "y": 160
        },
        "config": {
          "instances": 2,
          "concurrency": 80,
          "queueSize": 50,
          "latencyP50Ms": 15,
          "latencyP99Ms": 50,
          "costPerHour": 0.1
        }
      },
      {
        "id": "db",
        "kind": "database",
        "label": "PostgreSQL",
        "position": {
          "x": 923,
          "y": 160
        },
        "config": {
          "instances": 1,
          "concurrency": 20,
          "queueSize": 200,
          "latencyP50Ms": 8,
          "latencyP99Ms": 40,
          "costPerHour": 0.5
        }
      }
    ],
    "edges": [
      {
        "source": "client",
        "target": "lb",
        "latencyMs": 5
      },
      {
        "source": "lb",
        "target": "api",
        "latencyMs": 1
      },
      {
        "source": "api",
        "target": "db",
        "latencyMs": 1,
        "timeoutMs": 60,
        "retries": 3,
        "backoffMs": 10
      }
    ]
  },
  "scenario": {
    "seed": 42,
    "durationMs": 60000,
    "timeoutMs": 1000,
    "traffic": [
      {
        "atMs": 0,
        "rps": 1000.0
      }
    ],
    "slo": {
      "p99Ms": 250,
      "errorRate": 0.01
    },
    "windowMs": 1000,
    "events": [
      {
        "atMs": 20000,
        "node": "db",
        "action": "latency",
        "value": 2.0
      },
      {
        "atMs": 35000,
        "node": "db",
        "action": "up"
      }
    ]
  }
}
