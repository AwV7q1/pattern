{
  "id": "url-shortener",
  "title": "Dịch vụ rút gọn link",
  "difficulty": "Dễ",
  "timeMinutes": 30,
  "brief": "Thiết kế dịch vụ chuyển hướng link rút gọn (kiểu bit.ly). Gần như toàn bộ traffic là đọc: một mã ngắn được mở hàng nghìn lần. Mã đã tạo thì không đổi.",
  "requirements": [
    "3.000 lượt mở link mỗi giây, cao điểm gấp đôi",
    "p99 ≤ 150ms, lỗi ≤ 1%",
    "Mất một server API vẫn phục vụ bình thường",
    "Database chậm (backup, vacuum) không được làm sập dịch vụ",
    "Ngân sách $1.50/giờ"
  ],
  "talkingPoints": [
    "Cache-aside trước database: link không đổi nên hit rate rất cao",
    "N+1 instance cho API sau load balancer",
    "Timeout và retry có backoff khi gọi database",
    "Database chỉ nhận phần cache miss, nên không cần scale database"
  ],
  "level": {
